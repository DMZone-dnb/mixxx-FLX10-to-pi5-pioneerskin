[Unit]
Description=Re-apply the chosen master audio output (hdmi/jack/usb) to ~/.asoundrc
After=sound.target
Before=getty@tty1.service

[Service]
Type=oneshot
User=pi
ExecStartPre=/usr/bin/install -d -o pi -g pi /home/pi/.mixxx
ExecStart=/bin/bash -c '/usr/local/bin/djbox-audio.sh "$(cat /home/pi/.djbox-audio 2>/dev/null || echo hdmi)" --no-restart'

[Install]
WantedBy=multi-user.target
